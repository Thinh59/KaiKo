# Set these in Railway -> Variables.

# Postgres connection string. Railway provides this automatically if you add a
# Postgres plugin (reference it as ${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Separate KaiKo AI inference service URL, e.g. https://kaiko-ai.up.railway.app
AI_SERVICE_URL=http://localhost:8001
